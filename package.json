{
  "name": "time-theme-switcher",
  "version": "1.1.0",
  "description": "Solar-elevation-based Pi theme rotation (dawn/day/dusk/night) for the pi coding agent, with the palettes bundled.",
  "type": "module",
  "license": "MIT",
  "author": "jara",
  "keywords": [
    "pi-package",
    "pi-extension",
    "theme",
    "solar",
    "circadian"
  ],
  "files": [
    "README.md",
    "index.ts",
    "src",
    "themes",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "homepage": "https://github.com/mastnacek/time-theme-switcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/time-theme-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/mastnacek/time-theme-switcher/issues"
  },
  "scripts": {
    "test": "node --import ./test/register-jiti.mjs --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "themes:verify": "node test/verify-themes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
